      "text": "def check_alias(self, alias):\n    if FORBIDDEN_ALIAS_PATTERN.search(alias):\n        raise ValueError(\n            \"Column aliases cannot contain whitespace \"\n            \"characters, quotation marks, semicolons, \"\n            \"or SQL comments.\"\n        )",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "def check_alias(self, alias):\n    if FORBIDDEN_ALIAS_PATTERN.search(alias):\n        raise ValueError(\n            \"Column aliases cannot contain whitespace \"\n            \"characters, quotation marks, semicolons, \"\n            \"or SQL comments.\"\n        )",
