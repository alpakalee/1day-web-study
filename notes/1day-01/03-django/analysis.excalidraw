      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "FilteredRelation은 JOIN의 ON 조건에 추가 필터를 넣는다. 이 기능이 포함된 쿼리에서 조작된 alias가 SQL 구조에 영향을 줄 수 있었다.",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "FilteredRelation은 JOIN의 ON 조건에 추가 필터를 넣는다. 이 기능이 포함된 쿼리에서 조작된 alias가 SQL 구조에 영향을 줄 수 있었다.",
      "autoResize": false,
      "lineHeight": 1.25
    },
