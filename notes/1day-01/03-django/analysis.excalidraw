    {
      "id": "block-body-5-1-147",
      "type": "text",
      "x": 736,
      "y": 4605,
      "width": 588,
      "height": 225,
      "angle": 0,
      "strokeColor": "#0f172a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1N",
      "roundness": null,
      "seed": 1264096,
      "version": 1,
      "versionNonce": 15595166,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789391019463,
      "link": null,
      "locked": false,
      "fontSize": 18,
      "fontFamily": 3,
      "text": "MySQL 문서:\nControl+Z(0x1A)는 Windows SQL 파일\n가져오기에서 EOF로 작동 가능\n\nCR/LF를 그대로 로그에 쓰면\n공격자가 가짜 로그 레코드를 삽입 가능\n\n모두 CVE PoC가 아닌 실제 위험 유형",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "MySQL 문서:\nControl+Z(0x1A)는 Windows SQL 파일\n가져오기에서 EOF로 작동 가능\n\nCR/LF를 그대로 로그에 쓰면\n공격자가 가짜 로그 레코드를 삽입 가능\n\n모두 CVE PoC가 아닌 실제 위험 유형",
      "autoResize": false,
      "lineHeight": 1.25
    },
