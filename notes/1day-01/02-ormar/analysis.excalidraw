      "link": null,
      "locked": false,
      "fontSize": 18,
      "fontFamily": 3,
      "text": "@app.get(\"/aggregate\")\nasync def aggregate(column: str, op: str):\n    if op == \"max\":\n        result = await Item.objects.max(column)\n    else:\n        result = await Item.objects.min(column)\n    return {\"result\": result}",
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "@app.get(\"/aggregate\")\nasync def aggregate(column: str, op: str):\n    if op == \"max\":\n        result = await Item.objects.max(column)\n    else:\n        result = await Item.objects.min(column)\n    return {\"result\": result}",
      "autoResize": false,
      "lineHeight": 1.25
    },
